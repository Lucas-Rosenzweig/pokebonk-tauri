{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PokéBonk Tauri",
  "mainBinaryName": "pokebonk-tauri",
  "version": "0.1.2",
  "identifier": "io.github.lucas-rosenzweig.pokebonk-tauri",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.games",
    "shortDescription": "Client de bureau PokéBonk (non officiel)",
    "longDescription": "Client de bureau non officiel pour le jeu PokéBonk (pokebonk.com), écrit en Tauri.",
    "publisher": "Lucas Rosenzweig",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
